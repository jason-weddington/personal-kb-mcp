# Personal KB Web Service — P1 environment surface.
# Copy to .env (or source via direnv) and fill in real values.

# --- Auth (JWT signing) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Service-auth database (users, api_keys, invites, password_resets) ---
# This is the service's OWN database — distinct from the kb-core data DB below.
KB_SERVICE_DATABASE_URL=postgresql://kb_user:password@10.0.0.56:5432/kb_service
# Public base URL used for invite / password-reset links (behind a proxy).
KB_SERVICE_PUBLIC_URL=https://kb-service

# --- kb-core data database (the knowledge entries themselves) ---
# kb-core owns this schema/pool via create_postgres. The service adds nothing.
KB_DATABASE_URL=postgresql://kb_user:password@10.0.0.56:5432/personal_kb

# --- Embeddings (Ollama) ---
KB_OLLAMA_URL=http://localhost:11434
KB_EMBEDDING_MODEL=qwen3-embedding:0.6b
KB_EMBEDDING_DIM=1024
KB_OLLAMA_TIMEOUT=10.0

# --- Postgres connection pool (kb-core data DB) ---
KB_PG_POOL_MIN=1
KB_PG_POOL_MAX=5

# --- LLM providers (default: anthropic) ---
KB_EXTRACTION_PROVIDER=anthropic
KB_QUERY_PROVIDER=anthropic
# Read directly by kb-core (no KB_ prefix).
ANTHROPIC_API_KEY=sk-ant-...
KB_ANTHROPIC_MODEL=claude-haiku-4-5
KB_ANTHROPIC_TIMEOUT=30.0
